# =====================================================
# bisagym-api - Environment Production (Railway)
# Masukkan ini di Railway Dashboard > Service Settings > Variables
# =====================================================

APP_ENV=production
APP_NAME=BisaGym Face API
APP_TIMEZONE=Asia/Jakarta

# Generate 32+ character random string (contoh sudah siap pakai):
SECRET_KEY=0cb7273a46156d3070f91b0ee506aa548242a3d8a46870ed948fe8b5277ab134

# DATABASE_URL:
# Opsi 1 (1-Click MySQL di Railway): ${{MySQL.MYSQL_URL}}
# Opsi 2 (1-Click Postgres di Railway): ${{Postgres.DATABASE_URL}}
# Opsi 3 (Manual URL MySQL/Postgres): misal mysql://root:pass@mysql.railway.internal:3306/railway
DATABASE_URL=${{MySQL.MYSQL_URL}}

AUTO_CREATE_DB=true

# Izinkan domain website Niagahoster Anda
CORS_ORIGINS=https://fitfacely.com,https://www.fitfacely.com

# Model AI Pengenal Wajah (OpenCV SFace & YuNet)
FACE_ENGINE=opencv_sface
FACE_MODEL_NAME=opencv_sface
FACE_MODEL_VERSION=2021dec
FACE_DETECTION_MODEL_PATH=runtime-models/face_detection_yunet_2023mar.onnx
FACE_RECOGNITION_MODEL_PATH=runtime-models/face_recognition_sface_2021dec.onnx
FACE_DETECTION_MODEL_SHA256=8F2383E4DD3CFBB4553EA8718107FC0423210DC964F9F4280604804ED2552FA4
FACE_RECOGNITION_MODEL_SHA256=0BA9FBFA01B5270C96627C4EF784DA859931E02F04419C829E83484087C34E79
FACE_MATCH_THRESHOLD=0.50
FACE_MIN_QUALITY_SCORE=0.70
LIVENESS_MODE=none

DEVICE_AUTH_MODE=shared_secret
DEVICE_SHARED_SECRET=BisaGymDevice2026!
DEMO_PASSWORD=BisaGymAI2026!
