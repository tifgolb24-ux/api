# =====================================================
# bisagym-api - Environment Production (Render.com)
# JANGAN commit file ini! Isi di Render Dashboard > Environment
# =====================================================

APP_ENV=production
APP_NAME=BisaGym Face API
APP_TIMEZONE=Asia/Jakarta

# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=0cb7273a46156d3070f91b0ee506aa548242a3d8a46870ed948fe8b5277ab134

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database: Render PostgreSQL (gratis, otomatis terhubung via render.yaml)
# Format: postgresql+psycopg://user:password@host/dbname
# Nilai ini di-inject otomatis oleh Render dari bisagym-db
DATABASE_URL=postgresql+psycopg://bisagym:PASSWORD@HOST/bisagym

AUTO_CREATE_DB=true

# CORS: izinkan website fitfacely.com
CORS_ORIGINS=https://fitfacely.com,https://www.fitfacely.com

# Model AI - path relatif dari root bisagym-api/
FACE_ENGINE=opencv_sface
FACE_MODEL_NAME=opencv_sface
FACE_MODEL_VERSION=2021dec
FACE_DETECTION_MODEL_PATH=runtime-models/face_detection_yunet_2023mar.onnx
FACE_RECOGNITION_MODEL_PATH=runtime-models/face_recognition_sface_2021dec.onnx
FACE_DETECTION_MODEL_SHA256=8F2383E4DD3CFBB4553EA8718107FC0423210DC964F9F4280604804ED2552FA4
FACE_RECOGNITION_MODEL_SHA256=0BA9FBFA01B5270C96627C4EF784DA859931E02F04419C829E83484087C34E79
FACE_MATCH_THRESHOLD=0.50
FACE_MATCH_AMBIGUITY_MARGIN=0.05
FACE_ENROLLMENT_CONSISTENCY_THRESHOLD=0.45
FACE_MIN_QUALITY_SCORE=0.70
FACE_MAX_IMAGE_WIDTH=4096
FACE_MAX_IMAGE_HEIGHT=4096
FACE_MAX_IMAGE_PIXELS=12000000
FACE_MIN_SIZE_PIXELS=80
FACE_MIN_SIZE_RATIO=0.10
FACE_BLUR_THRESHOLD=80
FACE_MIN_EXPOSURE=45
FACE_MAX_EXPOSURE=210
FACE_MAX_CLIPPED_FRACTION=0.30
YUNET_SCORE_THRESHOLD=0.90
YUNET_NMS_THRESHOLD=0.30
YUNET_TOP_K=5000

LIVENESS_MODE=none
LIVENESS_MIN_SCORE=0.70
DEPTH_VALIDATION_ENABLED=false

DEVICE_AUTH_MODE=shared_secret
DEVICE_SHARED_SECRET=GANTI_DENGAN_SECRET_DEVICE_PRODUCTION
DEMO_PASSWORD=GANTI_BUKAN_GymDemo123!

CHECKIN_COOLDOWN_SECONDS=60
RAW_CAPTURE_STORAGE_ENABLED=false
RAW_CAPTURE_RETENTION_HOURS=24
MAX_SAMPLE_BYTES=5000000
